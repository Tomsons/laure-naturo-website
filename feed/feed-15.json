""},"attributes":{"width":480,"height":480,"loading":"lazy","decoding":"async"}}]},{"id":"17935080469945933","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17928939160970141_media_url_47ebc2aff8.jpeg","width":480,"height":480,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17928939160970141_media_url_47ebc2aff8.jpeg","width":480,"height":480,"format":"webp"},"src":"/_astro/17928939160970141_media_url_47ebc2aff8_rgf4Y.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":480,"height":480,"loading":"lazy","decoding":"async"}}]}]},"timestamp":"2022-02-21T15:15:33+0000","id":"17928939160970141","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17928939160970141_media_url_a80943379f.jpeg","width":480,"height":480,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17928939160970141_media_url_a80943379f.jpeg","width":480,"height":480,"format":"webp"},"src":"/_astro/17928939160970141_media_url_a80943379f_2hHBFU.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":480,"height":480,"loading":"lazy","decoding":"async"}}]}},{"feedJSON":{"media_type":"CAROUSEL_ALBUM","like_count":39,"comments_count":1,"caption":"Les fêtes approchent…\nEt les repas copieux aussi ! 🍽 😋 \n\nAfin de vivre au mieux ces moments festifs, je te donne 6 conseils naturels et faciles à appliquer : \n\n❄️ Consomme des fruits et des légumes pour leur teneur en vitamines et en fibres ce qui favorisera la digestion. \n\n❄️ Bois beaucoup d’eau : cela facilitera l’élimination des déchets de la digestion.\n\n❄️ Pratique une activité physique : marcher pendant 30min après un repas copieux aide à réduire la glycémie et le taux de triglycérides. \n\n❄️ Compense la prise d’alcool par de l’eau : l’alcool est connu pour déshydrater alors il est indispensable de bien s’hydrater en contre-partie.\n\n❄️ Évite de trop salé : tout comme l’alcool, le sel déshydrate, augmente la pression artérielle et favorise l’hypertension. \n\n❄️ Utilise une bouillotte chaude sur ton foie pour l’aider à se détoxifier après un gros repas. \nLes infusions 🌱 de chardon-marie, fenouil, gingembre, verveine, menthe, mélisse.. sont idéales après un repas copieux. \n\nEt enfin PROFITE ! Ces moments sont exceptionnels dans l’année, alors pas de culpabilité..! On reprendra les bonnes habitudes juste après ! 😊 \n\nEt toi ? As-tu des petits rituels pour passer de bonnes fêtes ? 🎉","shortcode":"CXgXLd_omQL","children":{"data":[{"id":"17942987512726087","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_554b9fbc94.jpeg","width":1080,"height":1080,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_554b9fbc94.jpeg","width":1080,"height":1080,"format":"webp"},"src":"/_astro/17869277090593504_media_url_554b9fbc94_msWUo.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1080,"height":1080,"loading":"lazy","decoding":"async"}}]},{"id":"17910285527248916","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_0cf3758870.jpeg","width":1080,"height":1080,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_0cf3758870.jpeg","width":1080,"height":1080,"format":"webp"},"src":"/_astro/17869277090593504_media_url_0cf3758870_Z1T6aME.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1080,"height":1080,"loading":"lazy","decoding":"async"}}]}]},"timestamp":"2021-12-15T13:45:46+0000","id":"17869277090593504","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_1da64cbdcb.jpeg","width":1080,"height":1080,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17869277090593504_media_url_1da64cbdcb.jpeg","width":1080,"height":1080,"format":"webp"},"src":"/_astro/17869277090593504_media_url_1da64cbdcb_Z1I9lXP.webp","srcSet":{"values
":1080,"height":1350,"loading":"lazy","decoding":"async"}}]},{"id":"18104922394703671","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17997188774706467_media_url_eb516aaed7.jpeg","width":1080,"height":1350,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17997188774706467_media_url_eb516aaed7.jpeg","width":1080,"height":1350,"format":"webp"},"src":"/_astro/17997188774706467_media_url_eb516aaed7_ahWSz.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1080,"height":1350,"loading":"lazy","decoding":"async"}}]}]},"timestamp":"2026-01-04T17:31:36+0000","id":"17997188774706467","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17997188774706467_media_url_d8541d7939.jpeg","width":1080,"height":1350,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17997188774706467_media_url_d8541d7939.jpeg","width":1080,"height":1350,"format":"webp"},"src":"/_astro/17997188774706467_media_url_d8541d7939_Z1E1t2g.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1080,"height":1350,"loading":"lazy","decoding":"async"}}]}},{"feedJSON":{"media_type":"IMAGE","like_count":17,"comments_count":1,"caption":"✨ Une très belle année se termine ✨\n\nAvant de tourner la page de 2025, j’ai surtout envie de dire merci 🙏 \n\nMerci à mes clientes fidèles,\ncelles qui reviennent,\ncelles qui me confient leur corps, leurs émotions, leur fatigue, leurs silences parfois 😌\n\nMerci aussi aux nouvelles personnes qui ont poussé la porte de mon univers cette année, et à celles qui me suivent ici, en toute discrétion ou avec de jolis messages bienveillants 🤍\n\nChaque rendez-vous, chaque échange, chaque retour me rappelle pourquoi j’aime autant mon métier 😍\n\n🌿 La naturopathie est mon socle pour vous apporter santé et vitalité. \n💦 Le drainage lymphatique, un pilier essentiel à votre bien-être.\n🌺 Le Kobido, une parenthèse beauté, détente, et detox du visage. \n✨ Et l’énergétique, une évidence qui s’est imposée naturellement pour apaiser votre système nerveux. \n\nEn janvier, je vais continuer à apprendre, à approfondir, à affiner encore + mon accompagnement.\nUne nouvelle étape se prépare.. avec toujours avec la même intention : vous accompagner au mieux ! \n\nJe ne dévoile rien pour l’instant 😉 mais cette évolution va enrichir ce que je vous propose déjà ✨\n\nMerci pour votre confiance.\nMerci d’être là.\nL’année 2026 s’annonce belle, humaine et pleine de bonheur 🍀","shortcode":"DS7W1p0jAJz","timestamp":"2025-12-31T12:14:33+0000","id":"17957644737022295","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17957644737022295_media_url_dd25c8c5e1.jpeg","width":1440,"height":1920,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17957644737022295_media_url_dd25c8c5e1.jpeg","width":1440,"height":1920,"format":"webp"},"src":"/_astro/17957644737022295_media_url_dd25c8c5e1_Z1BEJEv.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1440,"height":1920,"loading":"lazy","decoding":"async"}}]}},{"feedJSON":{"media_type":"IMAGE","like_count":18,"comments_count":9,"caption":"Ce soir, c’est le réveillon de Noël ✨🎄\n\nJe vous souhaite une soirée douce,\nentourée des personnes qui vous font du bien 🥰\nou simplement avec vous-même, si c’est ce dont vous avez besoin ! \n\nQue ce moment soit rempli de chaleur,\nd’amour, et de petits instants simples qui font du bien au cœur ✨\n\nPrenez soin de vous 🤍 \n\nLaure","shortcode":"DSpWqRQjMC4","timestamp":"2025-12-24T12:26:40+0000","id":"18118180402602108","media":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/18118180402602108_media_url_ec872d8840.jpeg","width":1440,"height":1920,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/18118180402602108_media_url_ec872d8840.jpeg","width":1440,"height":1920,"format":"webp"},"src":"/_astro/18118180402602108_media_url_ec872d8840_Z1d4qIM.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":1440,"height":1920,"loading":"lazy","decoding":"async"}}]}},{"feedJSON":{"media_type":"VIDEO","like_count":23,"comments_count":1,"caption":"✨ « J’ai ressenti une chaleur intense.. »\n✨ « j’ai eu comme des frissons de libération.. »\n✨ « J’ai lâché prise pour la première fois depuis longtemps.. »\n✨ « Je me suis sentie légère et apaisée » \n\nCes phrases, ce ne sont pas les miennes.\nCe sont les retours de mes clientes depuis que je propose le soin énergétique.\n\nUn soin doux, profond, qui aide :\n- à libérer les tensions émotionnelles\n- à apaiser l’anxiété et le mental qui tourne\n- à relancer la circulation énergétique\n- à retrouver une sensation d’ancrage et de clarté\n- à rééquilibrer le corps autrement ! \n\n🩵 C’est un moment pour souffler, se recentrer, recréer de l’espace en soi. \nAvant la fin d’année qui, souvent, nous vide plus qu’elle ne nous nourrit ! \n\n📍À Baron, proche Créon \n🌸 Réservation en ligne : lien dans ma bio","shortcode":"DSDPUd2jGY5","timestamp":"2025-12-09T17:12:23+0000","id":"17844838698628325","media":[{"type":"file","url":"/feed/1/17844838698628325_media_url_2452443757.mp4","mime":"video/mp4"}],"thumbnail":[{"rawOptions":{"src":"https://ln-admin.laurenaturo.fr/uploads/17844838698628325_media_url_8daf287553.jpeg","width":640,"height":1136,"format":"webp"},"options":{"src":"https://ln-admin.laurenaturo.fr/uploads/17844838698628325_media_url_8daf287553.jpeg","width":640,"height":1136,"format":"webp"},"src":"/_astro/17844838698628325_media_url_8daf287553_2oFGi0.webp","srcSet":{"values":[],"attribute":""},"attributes":{"width":640,"height":1136,"loading":"lazy","decoding":"async"}}]}}],"pageInfo":{"pageCount":24,"page":1,"total":120,"pageSize":5}}